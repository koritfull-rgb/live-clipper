{
  "name": "live-clipper",
  "productName": "Live Clipper",
  "version": "0.2.0",
  "description": "Нарезка клипов из живых стримов (Twitch, YouTube)",
  "author": "Live Clipper",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron.js .",
    "web": "node server.js --open",
    "icon": "node scripts/electron.js scripts/make-icon.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.liveclipper",
    "productName": "Live Clipper",
    "copyright": "Live Clipper",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "electron/**",
      "src/**",
      "public/**",
      "build/icon.png"
    ],
    "extraResources": [
      { "from": "bin", "to": "bin" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "LiveClipper-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Live Clipper",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
